From 6f6779bab382cd3ea0db7747b9b6e2bf75e5d521 Mon Sep 17 00:00:00 2001
From: asleep-ai/android-prebuilts <dev@asleep.ai>
Date: Fri, 18 Sep 2026 18:50:37 +0900
Subject: [PATCH] Raise Android BLE scan/connect fail timer to 60 s

AndroidBleManager arms MSG_BLE_FAIL with BLE_TIMEOUT_MS when onNewConnection()
starts the scan and re-arms it on every connectBLE() attempt. Some commissionees
take up to ~30 s before their first advertisement is seen, which makes
pairDeviceWithCode() fail with the stock 10 s. Raise the constant to 60 s; the
retry logic is unchanged.
---
 src/platform/android/java/chip/platform/AndroidBleManager.java | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/platform/android/java/chip/platform/AndroidBleManager.java b/src/platform/android/java/chip/platform/AndroidBleManager.java
index 1ca0256..5bc26b0 100644
--- a/src/platform/android/java/chip/platform/AndroidBleManager.java
+++ b/src/platform/android/java/chip/platform/AndroidBleManager.java
@@ -92,7 +92,7 @@ public class AndroidBleManager implements BleManager {
   private static final int MSG_BLE_CONNECT_RETRY = 3;
   private static final int MSG_BLE_FAIL = 99;
 
-  private static final int BLE_TIMEOUT_MS = 10000;
+  private static final int BLE_TIMEOUT_MS = 60000;
   private static final int BLUETOOTH_ENABLE_TIMEOUT_MS = 1000;
 
   private static final String MSG_BUNDLE_SERVICE_DATA = "serviceData";
-- 
